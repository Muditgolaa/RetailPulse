# Copy to backend/.env and adjust if needed. Never commit the real .env.
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml defaults (local development only).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailpulse

# Password given to every demo account by `npm run db:seed` (8+ characters).
# Choose your own locally; it is stored only as a bcrypt hash.
SEED_DEMO_PASSWORD=

# Signs login tokens. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Lets the login page's demo buttons sign in as the seeded demo accounts without a password.
# Turn on for local development or a public demo with fictional data only.
DEMO_LOGIN_ENABLED=false

# Groq AI provider (backend only; never put this key in frontend/ or commit it).
# Create a key at https://console.groq.com/keys, then run `npm run ai:check`.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000

# Production only: folder with the built frontend, served by Express (the Dockerfile sets this).
# FRONTEND_DIST=../frontend/dist
