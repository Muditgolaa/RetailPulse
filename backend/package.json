{
  "name": "retailpulse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p prisma",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:check": "tsx src/scripts/dbCheck.ts",
    "ai:check": "tsx src/scripts/aiCheck.ts",
    "kb:ingest": "tsx src/scripts/ingestKnowledge.ts",
    "kb:eval": "tsx src/scripts/evalKnowledge.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "tsx prisma/verify.ts",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.0",
    "prisma": "7.10.1",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
